# Copy only into an ignored, access-restricted local configuration file.
# Values are intentionally incomplete: missing credentials/JWKS must fail closed.
SP_DATABASE_URL=
SP_MIGRATION_DATABASE_URL=
SP_OPERATOR_ISSUER=https://issuer.example.invalid
SP_OPERATOR_AUDIENCE=security-platform-api
SP_JWKS_FILE=./secrets/operator-jwks.json
SP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SP_ALLOW_LOOPBACK_HTTP=false
