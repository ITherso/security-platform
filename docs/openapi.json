  "components": {
    "schemas": {
      "AntivirusStatus": {
        "properties": {
          "catalog_available": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Available"
          },
          "source": {
            "type": "string",
            "const": "self_reported",
            "title": "Source",
            "default": "self_reported"
          },
          "producer_verification": {
            "type": "string",
            "const": "not_verified",
            "title": "Producer Verification",
            "default": "not_verified"
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "source_observed_at": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32,
                "minLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Observed At"
          },
          "product_id": {
            "type": "string",
            "const": "antivirus",
            "title": "Product Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "unknown"
            ],
            "title": "Status",
            "default": "unknown"
          },
          "availability": {
            "type": "string",
            "enum": [
              "unavailable",
              "unknown"
            ],
            "title": "Availability",
            "default": "unknown"
          },
          "execution_available": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
